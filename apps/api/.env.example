DATABASE_URL=postgresql://stomat:stomat@localhost:5432/stomat
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me-long-random-string
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Mail (password reset, address verification, billing notices). Resend first, else SMTP; with neither, mails are written to the server log.
# RESEND_API_KEY=
# EMAIL_FROM=LANKA <notifications@lankaclinic.app>
# SMTP_URL=smtps://user:password@smtp.example.com:465
# AI features: one key for the whole service (create it at console.anthropic.com). Clinics do not see it; they only switch features on and get a monthly reply limit
# AI_API_KEY=
# AI_MODEL=claude-haiku-5-5
# Push notifications to staff phones (PWA). Generate once with `npm run vapid` and keep the private key secret
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# Instagram (the service's Meta app; see docs/02-hosting-and-security.md)
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_INSTAGRAM_APP_ID=   # the Instagram app id and secret (Meta dashboard: Instagram > API setup); if empty, META_APP_ID and META_APP_SECRET are used
# META_INSTAGRAM_APP_SECRET=
# META_CONFIG_ID=   # Facebook Login for Business configuration id (the "Connect with Facebook" button needs META_APP_ID, META_APP_SECRET and this)
# META_GRAPH_VERSION=v21.0
# META_APP_ID=   # the app id (needed for the "Connect Instagram" button: Instagram Business Login)
# Payments (LiqPay merchant keys; BILLING_ENFORCED defaults to on in production)
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=
# USD_UAH_RATE=
# BILLING_ENFORCED=true

# Server behaviour
# AUTO_SYNC_MINUTES=60            # reload from Cliniccards every N minutes (0 turns it off)
# AUTOMATIONS_TICK_SECONDS=60     # the scheduler of messages, reports, alerts and the waiting list (0 turns it off)
# PLATFORM_ADMIN_EMAILS=          # emails of the service owner (comma separated): access to /platform
# BILLING_ENFORCED=true           # on by default in production; false lets clinics in without payment
# DEMO_MAX_ACTIVE=300             # live copies of the demo clinic at once
# DEMO_AI_DAILY_CAP=200           # AI replies per day that all demo copies may use together
# MAIL_FROM=                      # the old name of EMAIL_FROM (still read)

# Writing to Cliniccards: OFF. Both stay unset until the manual verification stage with the clinic owner
# CLINICCARDS_WRITE_ENABLED=
# CLINICCARDS_WRITE_LIVE=

# Development and tests only. The server refuses to start in production with the first two set
# REQUIRE_EMAIL_VERIFICATION=false
# RATE_LIMIT_IP_MULTIPLIER=1
# TELEGRAM_POLL=false
# CLINICCARDS_BASE_URL=http://127.0.0.1:4010/api
# CLINICCARDS_MIN_INTERVAL_MS=0

