generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every entity with clinic data carries clinicId: data isolation between clinics from day one.

enum Role {
  OWNER
  MANAGER
  ADMIN
  DOCTOR
  ANALYST
}

enum Provider {
  CLINICCARDS
  TELEGRAM
  INSTAGRAM
  MESSENGER
  WHATSAPP
  VIBER
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

// The result of a contact with a patient on a task
enum TaskResult {
  BOOKED
  CALL_LATER
  NO_ANSWER
  DECLINED
}

// The patient's consent to communication: stored only by us, Cliniccards does not have it
enum ContactConsent {
  UNKNOWN
  GIVEN
  WITHDRAWN
}

enum SyncStatus {
  RUNNING
  OK
  FAILED
}

model Clinic {
  id                       String               @id @default(cuid())
  name                     String
  // The logo from the clinic's profile in Cliniccards (an image data URI, checked on load)
  logo                     String?
  // The data processing agreement accepted by the owner on behalf of the clinic
  termsVersion             String?
  termsAcceptedAt          DateTime?
  termsAcceptedById        String?
  // The clinic's working hours by weekday: { "1": {"from":"09:00","to":"20:00"}, ..., "7": null }.
  // 1 is Monday, null is a day off. Needed for free windows when Cliniccards has no doctor shifts.
  workHours                Json?
  createdAt                DateTime             @default(now())
  memberships              Membership[]
  integrations             Integration[]
  patients                 Patient[]
  visits                   Visit[]
  syncRuns                 SyncRun[]
  auditLogs                AuditLog[]
  tasks                    Task[]
  planItems                PlanItem[]
  payments                 Payment[]
  bookingAttempts          BookingAttempt[]
  kbItems                  KbItem[]
  metaSessions             MetaConnectSession[]
  automations              Automation[]
  automationRuns           AutomationRun[]
  waitlistEntries          WaitlistEntry[]
  slotOffers               SlotOffer[]
  scheduledReports         ScheduledReport[]
  alertRules               AlertRule[]
  invoices                 Invoice[]
  shifts                   Shift[]
  blocks                   ReservedBlock[]
  invitations              Invitation[]
  contactLogs              ContactLog[]
  imports                  ImportBatch[]
  reminders                Reminder[]
  treatmentPlans           TreatmentPlan[]
  cabinets                 Cabinet[]
  inquiries                Inquiry[]
  // Service messages (appointment reminders, a no-show) go out without the staff's confirmation. Marketing always goes through confirmation.
  autoSendService          Boolean              @default(false)
  // The master safety switch: while it is off, no message to a patient goes out (setup, queue and confirmation work)
  sendingEnabled           Boolean              @default(false)
  // The AI assistant: one key for the whole service (AI_API_KEY on the server), the clinic only turns it on and gets a monthly limit of replies
  aiEnabled                Boolean              @default(false)
  aiMonthlyLimit           Int                  @default(500)
  // The staff alert "the AI allowance is used up" (one per exhaustion episode, see AiService.limitAlert). aiLimitAlertAt: the Telegram message of the current
  // episode was really delivered. aiLimitAlertTryAt: the last claimed attempt (stops concurrent requests and paces the retries). Both are cleared when the budget is back.
  aiLimitAlertAt           DateTime?
  aiLimitAlertTryAt        DateTime?
  // The Telegram request of the current episode ended without an answer (a timeout, a network failure): Telegram may or may not have taken the message.
  // It is NOT counted as delivered, and it is not sent again in this episode (a repeat could be a duplicate); the in-app notice stays. Cleared with the two above.
  aiLimitAlertUnknownAt    DateTime?
  // Allow the AI to create an appointment itself. Always off by default; it cannot be turned on until the connector can write to the clinic's system
  aiAutoBooking            Boolean              @default(false)
  // Foundation of the AI administrator-agent (see .claude/docs/agent-administrator.md). Both are off by default and set only by the service owner.
  // aiAgentMode: turns on the agent's drafts for staff (the code reads it in the draft, approval and autonomy paths; with it off the old bot works as before).
  // funnelEventsEnabled: the only switch of the collection of funnel events and of the dialogue state rows; with it off nothing is written.
  aiAgentMode              Boolean              @default(false)
  funnelEventsEnabled      Boolean              @default(false)
  // The agent's limited AUTONOMOUS mode (answers, offers times, asks, books after the patient's consent without a button): off by default, never implied by
  // aiAgentMode, and effective only for the dialogs listed in the server variable AGENT_AUTO_DIALOGS and only for the services of its explicit set
  aiAgentAuto              Boolean              @default(false)
  // The set of services the autonomous mode may book (approved, active services of this clinic, at most five), chosen by the service owner. Authoritative once
  // agentAutoServicesSet is true (an empty set disables autonomy); before that the older single agentAutoServiceId still applies (kept for compatibility).
  // Where the autonomous mode applies. DIALOGS: the restricted test mode, only the dialogs of the server list AGENT_AUTO_DIALOGS (set by the service owner).
  // CLINIC: the clinic's owner switched the agent on for the whole clinic (needs the plan feature patient_agent, checked again at every action).
  agentAutoScope           String               @default("DIALOGS")
  agentAutoServiceIds      String[]             @default([])
  agentAutoServicesSet     Boolean              @default(false)
  agentAutoServiceId       String?
  conversationStates       ConversationState[]
  funnelEvents             FunnelEvent[]
  agentDrafts              AgentDraft[]
  // The AI replies to patients itself on safe topics (booking, reschedule, cancel, history); anything else it hands to a person. Off by default
  // What patients may be told about the clinic in a chat: set by the clinic itself (Cliniccards does not give them to us)
  // The doctor a new patient without preferences is booked to (the id in Cliniccards, and the name as it was when it was chosen)
  // HOW the schedule is organised: DOCTORS (by the doctors) or CABINETS (by the cabinets, through ONE shared account of Cliniccards used as doctor_id).
  // It is separate from the way a request is handled (a request for an administrator or the automatic booking).
  scheduleMode             String               @default("DOCTORS")
  // The currency in which this clinic's Cliniccards keeps payments, invoices, card balances and plan totals. Cliniccards sends amounts without a
  // currency, so it is never inferred: the clinic's owner states it (who and when are kept). null = not stated yet: amounts are shown as "currency not
  // confirmed". Loaded rows get it as their own stamp (currency below), so a later change does not relabel what was already loaded.
  sourceCurrency           String?
  sourceCurrencyStatedAt   DateTime?
  sourceCurrencyStatedById String?
  // The currency of treatment-plan TOTALS, stated separately (2026-11-16): Cliniccards documents them in the main currency at each plan's own rate,
  // but a clinic keeping some plans in another currency must be able to leave plans unconfirmed while stating payments. null = not stated.
  planCurrency             String?
  planCurrencyStatedAt     DateTime?
  planCurrencyStatedById   String?
  sharedDoctorId           String?
  sharedDoctorName         String?
  // Days with other hours or a day off: [{date, closed, from?, to?}] on top of workHours
  workHoursExceptions      Json                 @default("[]")
  // Where workHours came from: CLINICCARDS (GET /schedule-settings) or MANUAL (typed by the clinic); null while they were never set.
  // The default 09:00-20:00 shown in the form is NOT a setting and is never stored by itself.
  workHoursSource          String?
  workHoursUpdatedAt       DateTime?
  // Holidays of the clinic from Cliniccards (dates, closed days)
  workHoursHolidays        Json                 @default("[]")
  // The last time the price list was read from Cliniccards, and how many positions it had
  priceListSyncedAt        DateTime?
  priceListCount           Int?
  // Why the last price list was not applied in full (for example too many positions disappeared at once), or null
  priceListNote            String?
  primaryDoctorId          String?
  primaryDoctorName        String?
  publicAddress            String?
  publicPhone              String?
  publicDirections         String?
  aiAutoReply              Boolean              @default(false)
  // How many AI replies one chat gets per day (a guard against loops and cost), and how long the AI stays silent after a person answered (0: no pause)
  aiRepliesPerChatDay      Int                  @default(20)
  aiPauseMinutes           Int                  @default(30)
  // The owner confirms that the clinic's standard patient consent covers informational and advertising messages. Then "Unknown" counts as consent; "Withdrawn" always blocks
  assumeConsent            Boolean              @default(false)
  // The manager's digest in Telegram: OFF, DAILY or WEEKLY, the hour in Kyiv time, the weekday (1 = Monday) for WEEKLY
  digestFrequency          String               @default("OFF")
  digestHour               Int                  @default(9)
  digestWeekday            Int                  @default(1)
  lastDigestAt             DateTime?
  // A link where to send satisfied patients to leave a public review (Google and the like)
  reviewUrl                String?
  // Plan (TRIAL, START, PRO, CUSTOM), individual limits on top of the plan and suspension of the clinic by the service owner
  plan                     String               @default("START")
  limitOverrides           Json?
  // Billing: AWAITING_PAYMENT (registered, not paid: no access to real data), ACTIVE, PAST_DUE (paid period ended, grace days), LAPSED (grace over: blocked, data kept)
  billingStatus            String               @default("AWAITING_PAYMENT")
  // A visitor's copy of the demo clinic: made-up data, never billed, nothing is really sent
  // Writing appointments and patients to the clinic's system: set only by the service owner after the live verification
  // Chat widget for the clinic's own website: a public key, the sites it may run on and the greeting
  widgetKey                String?              @unique
  widgetEnabled            Boolean              @default(false)
  widgetOrigins            Json                 @default("[]")
  widgetGreeting           String?
  // Appearance of the widget (2026-11-17): the accent colour (#rrggbb) and the corner of the launcher (RIGHT or LEFT)
  widgetColor              String?
  widgetPosition           String               @default("RIGHT")
  // The first visitor message really received from an allowed site: "configured" is not "verified"
  widgetVerifiedAt         DateTime?
  // The AI (the agent's autonomous mode and the older automatic reply) may answer the website chat by itself: the owner's explicit choice, off by
  // default; installing or enabling the widget never sets it
  aiWebAuto                Boolean              @default(false)
  // Enquiries from the clinic's website forms (2026-11-17): leadKey is the PUBLIC form key a browser page carries (it works only from the listed sites);
  // a website's server sends with the separate secret, kept only as its SHA-256 (shown once, its last characters kept as a hint)
  leadKey                  String?              @unique
  leadEnabled              Boolean              @default(false)
  leadOrigins              Json                 @default("[]")
  leadFormConfig           Json?
  websiteConnectionRequests ContactRequest[]
  leadSecretHash           String?              @unique
  leadSecretHint           String?
  // The first enquiry really accepted from a website form
  leadVerifiedAt           DateTime?
  bookingWriteEnabled      Boolean              @default(false)
  isDemo                   Boolean              @default(false)
  demoExpiresAt            DateTime?
  // End of the paid month; the plan's allowances renew on every payment (periodStartsAt)
  paidUntil                DateTime?
  periodStartsAt           DateTime?
  setupPaidAt              DateTime?
  // AI replies bought in packs; they carry over and are spent only after the monthly included replies
  aiPurchased              Int                  @default(0)
  aiPackCapPerMonth        Int                  @default(5)
  suspendedAt              DateTime?
  // The owner requires two-factor sign-in from all the clinic's staff
  require2fa               Boolean              @default(false)
  // The AI assistant for the manager: free questions about the clinic's data, answered with a report. Separate from replies to patients
  aiAssistantEnabled       Boolean              @default(false)
  channelLinks             ChannelLink[]
  patientChannels          PatientChannel[]
  automationRules          AutomationRule[]
  outbox                   OutboundMessage[]
  chatMessages             ChatMessage[]
  inboundEvents            InboundEvent[]
  billingPayments          BillingPayment[]
  // A branch of a network (null: a standalone clinic). A branch keeps its own Cliniccards key, data, staff, allowances and settings; the network
  // only adds the consolidated views for people who already have a management role in the branch, and pays for the branches together.
  networkId                String?
  network                  Network?             @relation(fields: [networkId], references: [id], onDelete: SetNull)
  // The onboarding of an additional comparable branch is quoted individually by the service owner (from 2 990 UAH): the amount the network owner may
  // pay for it, set explicitly per branch; null = no quote, nothing to pay. Paid once.
  branchSetupQuoteUah      Int?
  branchSetupPaidAt        DateTime?
  bookingRequests          BookingRequest[]
  aiUsages                 AiUsage[]
  campaigns                Campaign[]
  savedReports             SavedReport[]
  digestRecipients         DigestRecipient[]
  reviews                  Review[]
  pushSubscriptions        PushSubscription[]
  chatBotResumes           ChatBotResume[]
  doctors                  Doctor[]
  doctorAvailability       DoctorAvailability[]
}

// A staff invitation by link. Only the token's hash is in the database: the link cannot be recovered from it.
model Invitation {
  id          String    @id @default(cuid())
  clinicId    String
  email       String
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

// A contact with a patient: a task result, a manual note or an import row
model ContactLog {
  id            String      @id @default(cuid())
  clinicId      String
  patientId     String
  userId        String?
  channel       String      @default("OTHER") // PHONE, MESSENGER, SMS, EMAIL, VISIT, OTHER
  outcome       TaskResult?
  note          String?
  source        String      @default("MANUAL") // MANUAL, TASK, IMPORT
  taskId        String?
  importBatchId String?
  contactedAt   DateTime    @default(now())
  createdAt     DateTime    @default(now())
  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId, contactedAt])
}

// An uploaded table (Excel/CSV): the rows are stored for the preview and for downloading the unmatched ones
model ImportBatch {
  id        String    @id @default(cuid())
  clinicId  String
  userId    String?
  filename  String
  type      String? // PATIENT_EXTRA or CONTACTS (chosen at apply time)
  columns   Json
  rows      Json
  status    String    @default("DRAFT") // DRAFT, DONE
  stats     Json      @default("{}")
  createdAt DateTime  @default(now())
  appliedAt DateTime?
  // Undo: previous values of the changed extra fields (patientId -> key -> old value), and when the import was undone
  undoData  Json?
  undoneAt  DateTime?
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
}

// A treatment plan item from Cliniccards (GET /planItems)
model PlanItem {
  id             String    @id @default(cuid())
  clinicId       String
  patientId      String
  externalId     String
  planId         String
  name           String
  price          Decimal?  @db.Decimal(12, 2)
  // NEW, PLANNED_TO_DO, DONE, INVOICED
  status         String
  createdAtExt   DateTime
  markedDoneAt   DateTime?
  // The service group in the Cliniccards price list ("Therapy", "Implantation"…): the treatment direction in the funnel
  groupName      String?
  doneByDoctorId String?
  clinic         Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([clinicId, externalId])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
  // Deleting a patient (a demo copy, a removed clinic) checks this column; without an index every deleted patient scanned the whole table
  @@index([patientId])
}

model Payment {
  id         String   @id @default(cuid())
  clinicId   String
  patientId  String?
  externalId String
  paidAt     DateTime
  amount     Decimal  @db.Decimal(12, 2)
  type       String?
  // Currency of the amount, stamped at load from Clinic.sourceCurrency; null = not confirmed. Never changed by a later setting (only by an explicit correction).
  currency   String?
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient    Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@unique([clinicId, externalId])
  @@index([clinicId, paidAt])
  @@index([patientId])
}

// An act of completed work (GET /invoices)
model Invoice {
  id         String   @id @default(cuid())
  clinicId   String
  patientId  String?
  externalId String
  issuedAt   DateTime
  amount     Decimal  @db.Decimal(12, 2)
  issuerName String?
  // As Payment.currency
  currency   String?
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient    Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@unique([clinicId, externalId])
  @@index([clinicId, issuedAt])
  @@index([patientId])
}

// A cabinet (GET /cabinets): needed to label free windows with a name, not a number
model Cabinet {
  id            String  @id @default(cuid())
  clinicId      String
  externalId    String
  name          String
  // Booking by cabinets: the cabinet is open for online booking / takes urgent patients (set by the clinic, never overwritten by the sync)
  onlineBooking Boolean @default(false)
  acceptsUrgent Boolean @default(false)
  clinic        Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, externalId])
}

// Treatment plan totals (GET /plans). The sums come in the clinic's main currency already with
// the fixed rate: the prices of single items may be in another currency, so "how much is left
// to do" is taken from here, not as the sum of item prices.
model TreatmentPlan {
  id           String   @id @default(cuid())
  clinicId     String
  externalId   String
  total        Decimal  @db.Decimal(14, 2)
  totalDone    Decimal  @db.Decimal(14, 2)
  // Stamped from Clinic.planCurrency (the owner's separate statement for plan totals); null = not confirmed
  currency     String?
  createdAtExt DateTime
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, externalId])
  @@index([clinicId, createdAtExt])
}

// An inquiry before a card exists or before an appointment (a call, a message, a request from the site). The administrator enters it;
// by phone the inquiry links itself to the patient's card when it appears. The top of the patient funnel.
model Inquiry {
  id            String   @id @default(cuid())
  clinicId      String
  occurredAt    DateTime @default(now())
  // PHONE, INSTAGRAM, TELEGRAM, VIBER, GOOGLE, SITE, WALK_IN, RECOMMENDATION, OTHER
  channel       String
  phone         String?
  phoneNorm     String?
  name          String?
  note          String?
  // OPEN or LOST (the person declined or did not book: marked by the administrator)
  status        String   @default("OPEN")
  patientId     String?
  // A patient with this phone already existed before the inquiry: this is not a new patient and is not counted in the acquisition funnel
  returning     Boolean  @default(false)
  // Where it came from: the campaign marks of the address (UTM), the page of the form, and the id of the lead in the ad system
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  landing       String?
  externalId    String?
  // Website integration (2026-11-17): the e-mail the visitor typed, how it arrived (WEBSITE_FORM), the form's own id and the referring site (its origin only)
  email         String?
  via           String?
  formId        String?
  referrer      String?
  // Meta Lead Ads (2026-11-17): the page, form, lead, ad, ad set and campaign ids as Meta gave them, the platform, organic or not, and the answers to the
  // form's custom questions (kept as text for the staff; never instructions, never sent to the AI)
  sourceDetails Json?
  createdById   String?
  createdAt     DateTime @default(now())
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@unique([clinicId, externalId])
  @@index([clinicId, occurredAt])
  @@index([clinicId, phoneNorm])
}

// A patient's connected messenger: a chat the bot can write to. One patient, one chat per channel.
// One chat can be linked to several cards (a family with one number).
model PatientChannel {
  id         String    @id @default(cuid())
  clinicId   String
  patientId  String
  // TELEGRAM
  channel    String
  externalId String
  username   String?
  linkedAt   DateTime  @default(now())
  // The patient wrote "Stop" or blocked the bot: we do not write any more
  optedOutAt DateTime?
  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, channel])
  @@index([clinicId, channel, externalId])
}

// A one-time "Connect reminders" link: only the hash is stored. With patientId it links the chat to a specific card.
model ChannelLink {
  id          String    @id @default(cuid())
  clinicId    String
  // PATIENT (linking a patient) or DIGEST (linking a digest recipient: the owner opens the link and the bot remembers their chat)
  purpose     String    @default("PATIENT")
  createdById String?
  patientId   String?
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

// A clinic's mailing scenario setting (whether it is on, due dates, texts). The list of scenarios is set in code.
model AutomationRule {
  id        String  @id @default(cuid())
  clinicId  String
  key       String
  enabled   Boolean @default(false)
  params    Json    @default("{}")
  templates Json    @default("{}")
  clinic    Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, key])
}

// A message to a patient: from "waiting for confirmation" to "sent". dedupeKey prevents creating the same one twice.
model OutboundMessage {
  id           String    @id @default(cuid())
  clinicId     String
  patientId    String
  ruleKey      String
  // TELEGRAM or SMS
  channel      String
  text         String
  // PENDING_APPROVAL, APPROVED, SENT, FAILED, CANCELLED, EXPIRED
  status       String    @default("PENDING_APPROVAL")
  scheduledFor DateTime
  // After this moment sending is no longer allowed (for example the visit has started)
  expiresAt    DateTime?
  sentAt       DateTime?
  error        String?
  dedupeKey    String
  visitId      String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  clinic       Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dedupeKey])
  @@index([clinicId, status, scheduledFor])
  @@index([patientId, createdAt])
}

// A reminder for staff about a patient (GET /reminders). This is not an appointment: it is used
// so that patients with an already planned contact are not shown in the "bring the patient back" lists.
model Reminder {
  id         String   @id @default(cuid())
  clinicId   String
  externalId String
  patientId  String?
  // Reminder day (a date without time, midnight UTC)
  dueDate    DateTime
  note       String?
  // NEW, DONE, CANCELLED, MOVED
  status     String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient    Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([clinicId, externalId])
  @@index([clinicId, dueDate])
  @@index([patientId])
}

// A doctor's shift in a cabinet (GET /schedule-shifts)
model Shift {
  id          String   @id @default(cuid())
  clinicId    String
  externalId  String
  doctorId    String
  doctorName  String?
  cabinetId   String
  cabinetName String?
  startsAt    DateTime
  endsAt      DateTime
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, externalId])
  @@index([clinicId, startsAt])
}

// Reserved time in a cabinet (GET /schedule-spaces)
model ReservedBlock {
  id         String   @id @default(cuid())
  clinicId   String
  externalId String
  cabinetId  String
  startsAt   DateTime
  endsAt     DateTime
  note       String?
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, externalId])
  @@index([clinicId, startsAt])
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  passwordHash       String
  createdAt          DateTime        @default(now())
  // Email confirmed by following the link from the letter
  emailVerifiedAt    DateTime?
  // A new address waiting for confirmation by the link sent to it; the sign-in email changes only after the link is opened
  pendingEmail       String?
  // The person's own photo (a JPEG, PNG or WebP data URI of at most 60 KB, checked by the server; never SVG)
  avatar             String?
  // Sessions (tokens) issued before this moment are invalid: changes on a password reset
  sessionsValidAfter DateTime?
  // Two-factor sign-in (TOTP). The secret is stored encrypted; it is on when totpEnabledAt is set
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  // The last accepted time step: the same code is not accepted a second time
  totpLastStep       Int?
  // Hashes of unused backup codes
  recoveryHashes     Json?
  authTokens         AuthToken[]
  memberships        Membership[]
  networkMembers     NetworkMember[]
  assignedTasks      Task[]          @relation("TaskAssignee")
  createdTasks       Task[]          @relation("TaskCreator")
  contactLogs        ContactLog[]
}

// One-time links from emails: password reset and email confirmation. Only the token's hash is in the database.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  // RESET, VERIFY or EMAIL_CHANGE
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// The platform inbox holds public callbacks and authenticated requests to connect an existing clinic website.
model ContactRequest {
  id        String    @id @default(cuid())
  phone     String?
  name      String?
  lang      String    @default("uk")
  createdAt DateTime  @default(now())
  handledAt DateTime?
  clinicId      String?
  clinic        Clinic?   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email         String?
  websiteOrigin String?
  installedAt   DateTime?

  @@index([createdAt])
  @@index([clinicId, createdAt])
}

// Attempt counters (sign-in, registration, password reset). In the database, not in memory: they work across several servers.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

model Task {
  id          String      @id @default(cuid())
  clinicId    String
  patientId   String?
  title       String
  note        String?
  // Where the task comes from: manual or a report code (for example report:no-next-visit); duplicates are not created by it
  source      String      @default("manual")
  dueDate     DateTime
  priority    Int         @default(1) // 1 normal, 2 high
  status      TaskStatus  @default(OPEN)
  result      TaskResult?
  assigneeId  String?
  createdById String?
  createdAt   DateTime    @default(now())
  completedAt DateTime?
  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  assignee    User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clinicId, status, dueDate])
  @@index([clinicId, patientId])
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  clinicId String
  role     Role
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
}

model Integration {
  id               String    @id @default(cuid())
  clinicId         String
  provider         Provider
  // Connection parameters (token, address, mode). The structure will be refined after studying the Cliniccards API.
  config           Json      @default("{}")
  // The Cliniccards API key, encrypted (AES-256-GCM, see common/crypto.ts). Never returned outside and never logged.
  apiKeyEnc        String?
  lastSyncAt       DateTime?
  // The daily automatic load (AutoSyncService, 03:00 in the clinic's time zone), Cliniccards only. autoSyncDay: the clinic day (YYYY-MM-DD) whose run was
  // claimed: the claim is an atomic update, so one server starts it. autoSyncAttempts: attempts of that day (at most 3). autoSyncRetryAt: when the next
  // attempt may start; while a run goes it is the end of its lease, so a run cut off by a restart is tried again after it (never right at start).
  autoSyncDay      String?
  autoSyncAttempts Int       @default(0)
  autoSyncRetryAt  DateTime?
  clinic           Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  syncRuns         SyncRun[]

  @@unique([clinicId, provider])
}

model Patient {
  id               String            @id @default(cuid())
  clinicId         String
  externalId       String // the patient's id in Cliniccards
  fullName         String
  phone            String?
  source           String? // the source of the inquiry
  preferredContact String?
  lastVisitAt      DateTime?
  balanceIssued    Decimal?          @db.Decimal(12, 2)
  balancePaid      Decimal?          @db.Decimal(12, 2)
  // Currency of balanceIssued / balancePaid, as Payment.currency
  balanceCurrency  String?
  // The patient is no longer in Cliniccards (deleted or merged with another): hidden from lists and reports, but our data is kept
  removedAt        DateTime?
  // When the card was created in Cliniccards and when the first visit was: the entry and stages of the patient funnel
  createdAtExt     DateTime?
  firstVisitAt     DateTime?
  // Date of birth from Cliniccards (only for the greeting)
  birthDate        DateTime?
  // A phone of digits only in one form (380...): import rows are matched by it
  phoneNorm        String?
  // Data that Cliniccards does not have. Sync does not touch these fields.
  consent          ContactConsent    @default(UNKNOWN)
  consentNote      String?
  consentUpdatedAt DateTime?
  automationPaused Boolean           @default(false)
  // Extra fields from an import: { "key": { "v": "value", "b": "upload id" } }
  extra            Json              @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  visits           Visit[]
  waitlistEntries  WaitlistEntry[]
  tasks            Task[]
  planItems        PlanItem[]
  payments         Payment[]
  invoices         Invoice[]
  contacts         ContactLog[]
  reminders        Reminder[]
  channels         PatientChannel[]
  outbox           OutboundMessage[]
  chatMessages     ChatMessage[]
  bookingRequests  BookingRequest[]
  inquiries        Inquiry[]
  reviews          Review[]

  @@unique([clinicId, externalId])
  @@index([clinicId, fullName])
  @@index([clinicId, phoneNorm])
}

model Visit {
  id                 String    @id @default(cuid())
  clinicId           String
  patientId          String
  externalId         String
  doctorId           String?
  doctorName         String?
  cabinetId          String?
  // When the appointment was created (not when the visit is): the "inquiry → appointment" time in the funnel
  bookedAt           DateTime?
  serviceName        String?
  startsAt           DateTime
  endsAt             DateTime?
  // The Cliniccards status as is: PLANNED, CONFIRMED, NOT_CONFIRMED, VISITED, MOVED,
  // DID_NOT_COME, IN_CLINIC, BOOKING, CANCELLED, IN_CHAIR
  status             String
  amount             Decimal?  @db.Decimal(12, 2)
  // The patient pressed "I confirm" on our reminder (kept only here; Cliniccards is not changed, and sync does not touch this field)
  patientConfirmedAt DateTime?
  clinic             Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([clinicId, externalId])
  @@index([clinicId, startsAt])
  @@index([patientId, startsAt])
}

model SyncRun {
  id            String      @id @default(cuid())
  clinicId      String
  integrationId String
  startedAt     DateTime    @default(now())
  finishedAt    DateTime?
  status        SyncStatus  @default(RUNNING)
  patients      Int         @default(0)
  visits        Int         @default(0)
  // The load progress for the indicator: percent and stage (patients, visits, treatment, finance, schedule, saving)
  progress      Int         @default(0)
  // refreshed while the load runs: a load without a recent one is treated as interrupted (see SyncService.failStale)
  heartbeatAt   DateTime?
  stage         String?
  // Other counters: treatment plans, payments, acts, shifts and so on.
  extra         Json        @default("{}")
  error         String?
  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  clinicId  String
  userId    String?
  action    String
  details   Json     @default("{}")
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
}

// "Give the dialog back to the bot": after a person answered in a chat the AI pauses for a while; staff can end the pause earlier,
// and only a person's messages written after this moment pause the AI again
model ChatBotResume {
  id        String   @id @default(cuid())
  clinicId  String
  channel   String
  chatId    String
  resumedAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, channel, chatId])
}

// A conversation with a patient in a messenger (incoming messages and staff replies). Not to be confused with OutboundMessage: those are automatic scenario messages.
// patientId is empty until the chat is linked to a card. chatId is the chat identifier in the external channel.
model ChatMessage {
  id           String    @id @default(cuid())
  clinicId     String
  patientId    String?
  // TELEGRAM or INSTAGRAM
  channel      String
  chatId       String
  contactName  String?
  // IN from the patient, OUT from the clinic
  direction    String
  text         String
  // For OUT: the staff member who wrote the reply; empty for an automatic system reply
  authorUserId String?
  // The reply was sent by the AI automatically
  byAi         Boolean   @default(false)
  // For IN: when a staff member opened the dialogue
  readAt       DateTime?
  // Id of the message in the messenger (Instagram resends webhooks; this makes handling idempotent)
  externalId   String?
  // Quick answers offered with this message (appointment times): [{label, payload}]
  buttons      Json?
  error        String?
  createdAt    DateTime  @default(now())
  clinic       Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@unique([clinicId, channel, externalId])
  @@index([clinicId, channel, chatId, createdAt])
  @@index([clinicId, createdAt])
  @@index([patientId, createdAt])
}

// A log of AI calls: only counters for the limit and cost calculation. The text of patients' messages is not stored here.
model AiUsage {
  id           String   @id @default(cuid())
  clinicId     String
  kind         String
  ok           Boolean
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  // Retries of one request (for example a report spec rebuilt after a mistake) are not billed
  billable     Boolean  @default(true)
  createdAt    DateTime @default(now())
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
}

// A request to the administrator from a conversation: a booking, reschedule, cancellation or a question the AI handed to a person.
// The administrator enters the appointment in Cliniccards by hand. Status NEW, DONE (entered) or DISMISSED (not needed).
model BookingRequest {
  id                String    @id @default(cuid())
  clinicId          String
  patientId         String?
  channel           String
  chatId            String
  contactName       String?
  // BOOKING, RESCHEDULE, CANCEL, HANDOFF
  kind              String
  summary           String
  status            String    @default("NEW")
  handledById       String?
  handledAt         DateTime?
  // What the person chose and told us, kept between messages: the service, the doctor, the chosen time (UTC), the name and phone they gave
  service           String?
  doctor            String?
  slotAt            DateTime?
  fullName          String?
  // The surname and the first name are collected as two separate answers (or labelled fields), never told apart by the order of words
  lastName          String?
  firstName         String?
  // The field the bot asked for last: all, lastName, firstName or phone
  askField          String?
  // How the request was scheduled when the times were offered (DOCTORS or CABINETS), the cabinet of the booking, and the doctor the patient WISHED
  // (only a wish: it is never booked through the shared account)
  scheduleMode      String?
  cabinetId         String?
  wishedDoctor      String?
  // The doctor of the request (the id in Cliniccards) and why him: CLIENT_CHOICE, CONTINUATION, PRIMARY, SERVICE_MATCH or URGENT
  doctorId          String?
  doctorReason      String?
  // PROPOSED: the person was offered a doctor (pendingDoctorId) and has not answered yet; AGREED: the person accepted the doctor
  doctorState       String?
  pendingDoctorId   String?
  // A sudden health problem: a priority request, never booked automatically
  urgent            Boolean   @default(false)
  phone             String?
  // NONE (no time chosen yet), COLLECT (a time is chosen, name or phone still missing), CONFIRM (the automatic mode waits for the person's yes),
  // READY (the request is complete and was passed on)
  stage             String    @default("NONE")
  // How many times the bot asked for the missing data (it stops asking after a few tries)
  asks              Int       @default(0)
  // The booking as it really is, confirmed by an administrator (ADMIN) or made by the automatic mode (AUTO); the client is told these values
  confirmedStartsAt DateTime?
  confirmedService  String?
  confirmedDoctor   String?
  confirmedAt       DateTime?
  confirmedBy       String?
  // CLINICCARDS (the visit was found in Cliniccards), MANUAL (an administrator confirms by hand), AUTO (created by the automatic mode)
  confirmSource     String?
  externalVisitId   String?
  // The message to the client about the confirmation: PENDING, SENT, FAILED or SKIPPED (sending is off, the person opted out)
  noticeStatus      String?
  noticeError       String?
  noticeAt          DateTime?
  // The automatic mode claims a request once: RUNNING, DONE, FAILED
  autoState         String?
  autoNote          String?
  // Why a booking could not be offered online (a fixed code, see BookingBlock): shown to the administrator next to the request
  blockCode         String?
  // The agent path (aiAgentMode): what the patient was asked to confirm (consentKey: service, time and the other material parameters at the moment of the
  // question), when they said yes, and the question's message
  consentKey        String?
  consentAt         DateTime?
  consentMessageId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient           Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([clinicId, status, createdAt])
  @@index([clinicId, channel, chatId, status])
}

// A custom campaign: for example a promotion. Always marketing: only to patients with consent and only with the staff's confirmation.
// filters: { monthsSinceVisitMin?, monthsSinceVisitMax?, noFutureVisit? }. Status DRAFT or QUEUED (messages are created in the queue).
model Campaign {
  id          String    @id @default(cuid())
  clinicId    String
  name        String
  text        String
  filters     Json
  status      String    @default("DRAFT")
  queuedAt    DateTime?
  queuedCount Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
}

// A saved custom report: the description (spec) is recalculated on every open, so the data is always fresh
model SavedReport {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  spec        Json
  createdById String?
  createdAt   DateTime @default(now())
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
}

// A digest recipient: the manager's chat in Telegram. Linked by a link from the settings, not by phone number.
model DigestRecipient {
  id        String   @id @default(cuid())
  clinicId  String
  chatId    String
  name      String
  lang      String   @default("uk")
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, chatId])
}

// The patient's rating after a visit (1-5), collected by the bot with buttons. One per visit. A low rating waits for a comment (awaitingUntil).
model Review {
  id            String    @id @default(cuid())
  clinicId      String
  patientId     String
  visitId       String    @unique
  rating        Int
  doctorName    String?
  comment       String?
  awaitingUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
  @@index([clinicId, doctorName])
}

// Push subscription of one browser or phone (PWA) of a staff member: used to tell them about new requests
model PushSubscription {
  id        String   @id @default(cuid())
  clinicId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([userId])
}

// Every incoming event from a messenger is stored first and processed after, so that a failure never loses it.
// PENDING (waits or is being processed), DONE, FAILED (gave up after several attempts; staff can retry).
model InboundEvent {
  id            String    @id @default(cuid())
  clinicId      String
  channel       String
  // Id from the messenger; a repeated delivery of the same id is ignored
  externalId    String?
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([status, nextAttemptAt])
  @@index([clinicId, status])
}

// One LiqPay order. kind: SUBSCRIPTION (first one also carries the setup fee), AI_PACK.
// status: PENDING, PAID, FAILED. The callback is idempotent by orderId.
model BillingPayment {
  id          String    @id @default(cuid())
  clinicId    String
  // a network payment (kind NETWORK: the monthly network subscription; BRANCH_SETUP: a quoted branch onboarding); clinicId is then the branch it was
  // started from (NETWORK) or the branch being onboarded (BRANCH_SETUP)
  networkId   String?
  // NETWORK: the start of the network period this payment buys (one period is granted once, also when two payment windows are both paid)
  periodFrom  DateTime?
  orderId     String    @unique
  kind        String
  plan        String?
  // Amount in UAH kopecks (what LiqPay charges)
  amountMinor Int
  // The setup fee included in the amount (kopecks), for the receipt
  setupMinor  Int       @default(0)
  // AI replies in a pack
  packReplies Int       @default(0)
  status      String    @default("PENDING")
  providerRef String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
}

// One write to the clinic's system. The unique key makes a repeated request return the first result instead of writing again.
// kind: CREATE, RESCHEDULE, CANCEL, CONFIRM, PATIENT.
// status: STARTED (sent, no answer yet), DONE, FAILED (Cliniccards refused: nothing was written), UNKNOWN (no clear answer: check before retrying).
model BookingAttempt {
  id                String    @id @default(cuid())
  clinicId          String
  key               String
  kind              String
  patientId         String?
  requestId         String?
  startsAt          DateTime?
  externalVisitId   String?
  externalPatientId String?
  status            String    @default("STARTED")
  error             String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, key])
  @@index([clinicId, createdAt])
}

// A doctor of the clinic as Cliniccards lists them (GET /staff, role DOCTOR), with what LANKA knows about him: the services he provides
// (ids of KbItem SERVICE; empty means unknown, so the bot never books him automatically) and whether he takes urgent patients.
model Doctor {
  id            String   @id @default(cuid())
  clinicId      String
  externalId    String
  lastName      String
  firstName     String
  active        Boolean  @default(true)
  serviceIds    String[] @default([])
  acceptsUrgent Boolean  @default(false)
  refreshedAt   DateTime @default(now())
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, externalId])
}

// The schedule of online booking that the clinic sets in LANKA for a doctor whose shifts are not kept in Cliniccards: a weekly row (weekday,
// hours, cabinet) or an exception for one date (closed, or other hours). It is only a rule of when he may be booked: the visits and blocks
// of Cliniccards are always subtracted from it.
model DoctorAvailability {
  id        String  @id @default(cuid())
  clinicId  String
  doctorId  String
  weekday   Int?
  date      String?
  closed    Boolean @default(false)
  fromHm    String?
  toHm      String?
  cabinetId String?
  clinic    Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, doctorId])
}

// What the AI may tell patients about the clinic. Only approved items reach the model; a change to the content needs a new approval;
// a price is quoted only while it was reviewed in the last 90 days. kind: SERVICE, DOCTOR, LOCATION, FAQ.
model KbItem {
  id                 String    @id @default(cuid())
  clinicId           String
  kind               String
  // Service or doctor name, place name, or the question of a FAQ entry
  title              String
  // Price list group (for example Therapy), shown to the AI next to a service name
  category           String?
  // Preparation notes, about the doctor, address and how to get there, or the answer of a FAQ entry
  text               String    @default("")
  durationMin        Int?
  // Booking by cabinets: the service may be booked online (needs a known length), and in which cabinets (empty: any online cabinet)
  onlineBooking      Boolean   @default(false)
  cabinetIds         String[]  @default([])
  // What the price list of Cliniccards has for this position now (the name and the price in the system's currency), kept apart from the
  // approved text so that a change in Cliniccards is visible but never silently changes what the bot says
  externalTitle      String?
  externalPrice      Int?
  // The price list of Cliniccards, read in full and with success, no longer has this position: new online bookings of it are paused until an
  // administrator decides (keep it as the clinic's own service, or switch it off). History and existing requests stay.
  missingInSourceAt  DateTime?
  // The administrator saw the price Cliniccards has and chose to keep the clinic's own: that source price is no longer a discrepancy
  externalPriceAcked Int?
  // Fields of an imported position that the clinic set by hand on purpose (title, text, priceUah): an import never overwrites them. Every other
  // field follows the price list of Cliniccards by itself. A price set by hand is also how "free" (0) is kept.
  localFields        String[]  @default([])
  // A hand-made service whose name equals an imported position was left separate on purpose
  matchDismissed     Boolean   @default(false)
  // Approved price in hryvnias (whole); the currency of the clinic's system is not trusted, so a person confirms it
  priceUah           Int?
  active             Boolean   @default(true)
  // MANUAL, or CLINICCARDS for a draft imported from the price list
  source             String    @default("MANUAL")
  externalId         String?
  approvedAt         DateTime?
  approvedById       String?
  // The last time a person confirmed that the item is still true
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  clinic             Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, kind, externalId])
  @@index([clinicId, kind])
}

// A saved report that is calculated on a schedule and mailed as a file. Recipients are members of the clinic only; each one gets the
// report calculated for their own role (so money fields a role may not see make the report fail for that person, not leak).
// frequency: DAILY, WEEKLY (weekday 1-7), MONTHLY (monthDay 1-28).
model ScheduledReport {
  id            String    @id @default(cuid())
  clinicId      String
  savedReportId String
  frequency     String
  hour          Int       @default(8)
  weekday       Int       @default(1)
  monthDay      Int       @default(1)
  // XLSX or PDF
  format        String    @default("XLSX")
  // User ids of the clinic's members
  recipientIds  Json      @default("[]")
  enabled       Boolean   @default(true)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  lastStatus    String?
  lastError     String?
  createdById   String?
  createdAt     DateTime  @default(now())
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([enabled, nextRunAt])
}

// A deviation the manager wants to hear about. kind: CANCEL_RATE (share of cancelled and missed visits, percent), RETURN_DROP (fall of
// completed visits against the previous period, percent), STALE_REQUESTS (requests waiting longer than `hours`, count).
// Calculated by code; a rule that fired stays quiet for 24 hours.
model AlertRule {
  id          String    @id @default(cuid())
  clinicId    String
  kind        String
  threshold   Float
  windowDays  Int       @default(7)
  hours       Int       @default(4)
  enabled     Boolean   @default(false)
  lastFiredAt DateTime?
  lastValue   Float?
  createdAt   DateTime  @default(now())
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, kind])
}

// A patient who waits for a suitable time. The code looks for free windows that fit and offers one through the approval queue.
// status: ACTIVE (waiting), OFFERED (an offer is out), DONE (accepted a time), CANCELLED. An entry lives 30 days.
model WaitlistEntry {
  id          String      @id @default(cuid())
  clinicId    String
  patientId   String
  // Wished doctor as the schedule names them; empty means any
  doctorName  String?
  // Days of the week 1 (Monday) to 7 (Sunday); empty means any
  weekdays    Json        @default("[]")
  fromHour    Int         @default(9)
  toHour      Int         @default(20)
  note        String?
  status      String      @default("ACTIVE")
  expiresAt   DateTime
  createdById String?
  createdAt   DateTime    @default(now())
  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  offers      SlotOffer[]

  @@index([clinicId, status])
}

// One free time offered to one waiting patient. `activeKey` holds the slot while the offer is open and is unique per clinic, so
// the database itself never lets one window be offered to two people at once; it is cleared when the offer ends.
// status: OFFERED, ACCEPTED, DECLINED, EXPIRED.
model SlotOffer {
  id          String        @id @default(cuid())
  clinicId    String
  entryId     String
  patientId   String
  slotKey     String
  activeKey   String?
  startsAt    DateTime
  doctorName  String?
  cabinetName String?
  status      String        @default("OFFERED")
  // The queue message that carries the offer; the time to answer starts when it is really sent
  outboundId  String?
  sentAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  entry       WaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([clinicId, activeKey])
  @@index([clinicId, status])
  @@index([entryId])
}

// An automation made by the clinic: when something happens (trigger), and the patient fits the conditions, do something (action).
// trigger: {type: VISIT_BEFORE, hours} | {type: VISIT_AFTER, status, delayHours} | {type: NO_VISIT, days} | {type: TREATMENT_OPEN, days} | {type: BIRTHDAY}
// conditions: {noOtherFutureVisit, source, minVisits, maxVisits, doctor, service}
// action: {type: SEND_MESSAGE | CREATE_REQUEST, text}; kind: service (a message about a visit) or marketing (needs consent, at most one in 14 days)
// stop: {ifBooked, ifReplied} are checked again right before sending.
model Automation {
  id          String          @id @default(cuid())
  clinicId    String
  name        String
  enabled     Boolean         @default(false)
  kind        String          @default("service")
  trigger     Json
  conditions  Json            @default("{}")
  action      Json
  stop        Json            @default("{}")
  templateKey String?
  createdById String?
  createdAt   DateTime        @default(now())
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  hits        AutomationHit[]
  runs        AutomationRun[]

  @@index([clinicId, enabled])
}

// What an automation already did for whom: the key keeps one action per visit or per patient and period
model AutomationHit {
  id           String     @id @default(cuid())
  clinicId     String
  automationId String
  dedupeKey    String
  patientId    String
  outcome      String
  createdAt    DateTime   @default(now())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, dedupeKey])
  @@index([clinicId, createdAt])
}

// The journal: one row for every check that found someone, with the reasons why others were skipped
model AutomationRun {
  id           String     @id @default(cuid())
  clinicId     String
  automationId String
  at           DateTime   @default(now())
  candidates   Int
  queued       Int
  requests     Int
  skipped      Json       @default("{}")
  clinic       Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, at])
}

// A request from Meta (a person asked Facebook or Instagram to delete what an app holds about them) and what we did about it.
// The confirmation code is shown on the public status page.
model DataDeletionRequest {
  id             String   @id @default(cuid())
  code           String   @unique
  source         String   @default("META")
  // The id of the person as Meta gives it (an account that connected a channel; for Instagram it is the account id)
  externalUserId String
  // DEAUTHORIZED (access taken away) or DELETED (data removed)
  status         String
  summary        Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([externalUserId])
}

// Between the return from Facebook and the choice of the clinic's page: the token that came back (encrypted) and what it can reach.
// Lives 15 minutes, is deleted after the connection is made and holds no page tokens.
model MetaConnectSession {
  id        String   @id @default(cuid())
  clinicId  String
  userId    String
  tokenEnc  String
  // {type, expiresAt (ms, null = never expires)}
  tokenInfo Json
  // [{id, name, igId, igUsername}]
  pages     Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

// A session token that was signed out of: the token id is refused until the token would have expired anyway
model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// The state of one permanent chat (clinic + channel + chat). Stage 0 only creates it as the anchor of funnel events; the other fields are
// reserved for the agent. It holds no name, phone or message text.
model ConversationState {
  id                    String        @id @default(cuid())
  clinicId              String
  channel               String
  chatId                String
  // BOT or HUMAN: who owns the dialogue (reserved)
  owner                 String        @default("BOT")
  // NEW, DISCOVERY, OFFERED, CONSENT, BOOKING, HANDED, DECLINED, CLOSED (reserved)
  salesStage            String        @default("NEW")
  serviceId             String?
  clarifyCount          Int           @default(0)
  doubtsHandled         String[]      @default([])
  lastDecisionMessageId String?
  version               Int           @default(0)
  leaseToken            String?
  leaseUntil            DateTime?
  // the last incoming message the autonomous turn has handled
  autoSeenAt            DateTime?
  autoSeenId            String?
  // the booking request of this dialogue (the agent path): the consent and the visit are on that row
  bookingRequestId      String?
  // The agent's offer of times that was really SENT: its message, when, and the service it was for. A time is accepted only from this message.
  offerMessageId        String?
  offeredAt             DateTime?
  offerService          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  clinic                Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  events                FunnelEvent[]

  @@unique([clinicId, channel, chatId])
}

// One real action in the funnel. The unique key makes a repeated webhook, a retry or a repeated click write the same event once. No message text.
// One conversation is a PERMANENT CHAT, not an episode: INQUIRY is written once per chat, so its count is "chats that wrote since the collection
// was switched on", not "new enquiries".
model FunnelEvent {
  id             String            @id @default(cuid())
  clinicId       String
  conversationId String
  // INQUIRY, TIME_OFFERED, CLIENT_CONFIRMED, BOOKED, HANDED_OFF, DECLINED (DECLINED has no source action yet)
  kind           String
  // What the action is keyed by (an outgoing message id, a request id and the time, ...): the same action never gets a second key
  refKey         String
  reason         String?
  // AUTO or ADMIN (for BOOKED)
  source         String?
  // EXISTING_LINKED when the chat is tied to a card, UNKNOWN otherwise
  leadStatus     String?
  occurredAt     DateTime          @default(now())
  clinic         Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation   ConversationState @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([clinicId, conversationId, kind, refKey])
  @@index([clinicId, occurredAt])
}

// The agent's draft kept for a staff member to review and approve. It holds only what is needed to CHECK and APPROVE it (the text, the action, the offered
// times, the services whose prices the text states, the hand-over code), tied to the clinic, the chat, the incoming message it answers and the state
// version it was made from. It never holds the conversation history. The browser sends only the id, the revision it saw and the button it pressed;
// the action, the prices, the slots and the clinic always come from here. Rows older than 30 days are deleted (see AgentApprovalService.purge) and
// with a chat that is deleted on request.
model AgentDraft {
  id                   String    @id @default(cuid())
  clinicId             String
  channel              String
  chatId               String
  basisMessageId       String
  basisAt              DateTime
  stateVersion         Int
  basisOwner           String    @default("BOT")
  createdById          String?
  // raised each time the content shown to the staff member changes (for example new free times): an approval is valid only for the revision that was seen
  revision             Int       @default(1)
  // PENDING, APPROVING, SENT, REJECTED, SUPERSEDED, FAILED (a confirmed refusal), UNKNOWN (the result of a send is not known: never repeated blindly)
  status               String    @default("PENDING")
  snapshot             Json
  approvedById         String?
  approvedAt           DateTime?
  choice               String?
  // the channel's confirmation that it accepted this approval's message (stored right after the transport answered)
  transportConfirmedAt DateTime?
  messageId            String?
  requestId            String?
  error                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  clinic               Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, channel, chatId, createdAt])
  @@index([createdAt])
}

// A network of clinics (decided 2026-11-16). Created only by the service owner for an individually agreed contract; clinics are never grouped
// automatically. 7 990 UAH/month includes two branches with Pro capabilities, each further branch 2 990 UAH/month; the first onboarding 4 990 UAH
// once; a further branch's onboarding is quoted per branch (Clinic.branchSetupQuoteUah). Usage allowances stay per branch.
model Network {
  id             String          @id @default(cuid())
  name           String
  // AWAITING_PAYMENT, ACTIVE, PAST_DUE, LAPSED (the same steps as a clinic); applied to every branch
  billingStatus  String          @default("AWAITING_PAYMENT")
  paidUntil      DateTime?
  periodStartsAt DateTime?
  setupPaidAt    DateTime?
  // the network digest by email to the network's owners: OFF, WEEKLY, DAILY
  digest         String          @default("WEEKLY")
  lastDigestAt   DateTime?
  createdAt      DateTime        @default(now())
  clinics        Clinic[]
  members        NetworkMember[]
}

// A person of the network: OWNER pays for the network and manages its digest. What a member sees of a branch still depends on their own role IN that
// branch (Membership): the network never gives access to a branch by itself.
model NetworkMember {
  id        String   @id @default(cuid())
  networkId String
  userId    String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())
  network   Network  @relation(fields: [networkId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([networkId, userId])
}
